{
  "name": "nextjs-financehub-template",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Next.js 14 LTS SaaS template — FinanceHub. Includes centralized API module, Composer pattern, Docker, linting, type-checking, and unit test scaffolding.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --forceExit",
    "validate": "npm run lint && npm run type-check && npm run test:ci && npm run build",
    "docker:build": "docker build -t financehub:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local financehub:latest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sass": "^1.100.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.8",
    "@types/node": "^20",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3"
  }
}
